{
  "name": "nori-tc-electron",
  "version": "2.0.1",
  "description": "클릭·텍스트입력·페이지이동을 녹화하고 그대로 재생하는 Electron 자동화 도구 (browser-clicker-ext의 Electron 포팅)",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "electron-builder --publish always"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.norisystem.noritc",
    "productName": "Nori-TC",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*.js",
      "webview-preload.js",
      "index.html",
      "login.html",
      "login-renderer.js"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "larry-id",
        "repo": "Electron",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
